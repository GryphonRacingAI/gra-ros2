<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>fastslam_ros</name>
  <version>0.0.1</version>
  <description>ROS 2 wrapper for the GPU-accelerated FastSLAM 1.0 implementation.</description>
  <maintainer email="user@todo.todo">Your Name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Core ROS Dependencies (used at runtime) -->
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>

  <!-- Non-ROS Python Dependencies (Numpy is crucial for the fastslam core) -->
  <exec_depend>python3-numpy</exec_depend>
  
  <!-- Add your custom message package dependency here (e.g., FSAI cone messages) -->
  <!-- <depend>fsai_msgs</depend> --> 

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
