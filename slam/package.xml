<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>slam</name>
  <version>0.0.1</version>
  <description>ROS 2 wrapper for the GPU-accelerated FastSLAM 1.0</description>
  <maintainer email="hashamahmad1818@gmail.com">Hasham Ahmad</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>message_filters</depend>
  <depend>common_msgs</depend>
  
  <!-- Non-ROS System Dependencies (Crucial for the GPU core) -->
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pycuda</exec_depend> 
  
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
