#!/usr/bin/env python3

import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Point
from common_msgs.msg import ConeArray
from nav_msgs.msg import Odometry
from std_msgs.msg import UInt16
import math


class LapCounter(Node):
    """Counts laps from the large orange gate cones in the velodyne frame.

    While the gate is far away the stored pair is updated from detections.
    Once the nearest gate cone comes within handoff_distance the pair is
    locked and dead-reckoned from odometry velocity only, because close-range
    detections are unreliable (FOV clipping) exactly when the crossing
    happens. After a lap the counter re-arms only when the gate is seen far
    away again, which acts as the cooldown."""

    def __init__(self):
        super().__init__('lap_counter')

        self.cone_frame = 'velodyne'    # The frame the cones are published in

        self.handoff_distance = self.declare_parameter('handoff_distance', 6.0).value
        self.lock_timeout = self.declare_parameter('lock_timeout', 5.0).value

        # Subscribers
        self.cone_sub = self.create_subscription(
            ConeArray,
            '/cone_array',
            self.cone_callback,
            10
        )
        self.odom_sub = self.create_subscription(
            Odometry,
            '/zed/zed_node/odom',
            self.odom_callback,
            10
        )

        # Publisher
        self.lap_counter_pub = self.create_publisher(UInt16, '/laps', 10)

        # State variables
        self.locked = False         # False: update pair from detections, True: dead-reckon
        self.pair = None            # stored gate pair (A, B) in velodyne frame
        self.pair_time = None
        self.pair_sign = 0.0
        self.lap_count = 0
        self.car_vel = [0.0, 0.0]

        # Timer for periodic publishing
        self.publish_timer = self.create_timer(1.0, self.publish_lap_count)

        self.get_logger().info(
            f"Lap Counter node initialised. Tracking laps in velodyne frame, "
            f"handoff_distance={self.handoff_distance}m")

    def select_gate_pair(self, cones):
        """Pick the two cones that plausibly form the gate: separated by a
        gate width and roughly perpendicular to the direction of travel,
        nearest gate first. Taking the first two detections is not enough:
        they can be cones of different gates/track features (same side, many
        metres apart), whose line never flips sign."""
        best, best_key = None, None
        for i in range(len(cones)):
            for j in range(i + 1, len(cones)):
                A, B = cones[i], cones[j]
                width = math.hypot(A.x - B.x, A.y - B.y)
                if not (1.5 < width < 6.0) or abs(A.x - B.x) > 3.0:
                    continue
                mean_dist = (math.hypot(A.x, A.y) + math.hypot(B.x, B.y)) / 2
                key = (abs(A.x - B.x), mean_dist)
                if best_key is None or key < best_key:
                    best, best_key = [A, B], key
        return best

    def cone_callback(self, msg):
        pair = self.select_gate_pair([cone.position for cone in msg.large_orange_cones])
        now = self.get_clock().now()

        if not self.locked:
            if pair and min(math.hypot(p.x, p.y) for p in pair) >= self.handoff_distance:
                # gate seen far away: stateful estimate = detection
                A, B = pair
                self.pair = (Point(x=A.x, y=A.y), Point(x=B.x, y=B.y))
                self.pair_time = now
                s = A.x * B.y - A.y * B.x
                self.pair_sign = s if abs(s) > 1e-6 else 0.0
            elif self.pair and (now - self.pair_time).nanoseconds / 1e9 >= 0.7:
                # gate close or detection gone for a while: freeze the estimate
                # and dead-reckon to the crossing, ignoring close-range detections
                self.locked = True
                self.get_logger().info("Gate pair locked, dead-reckoning to the crossing")

        if self.locked:
            self.predict_step(now)

    def predict_step(self, now):
        dt = (now - self.pair_time).nanoseconds / 1e9
        A0, B0 = self.pair
        vx, vy = self.car_vel
        A = Point(x=A0.x - vx * dt, y=A0.y - vy * dt)
        B = Point(x=B0.x - vx * dt, y=B0.y - vy * dt)
        s_now = A.x * B.y - A.y * B.x

        if self.pair_sign * s_now < 0 and abs(s_now) > 1e-3:
            self.lap_count += 1
            self.get_logger().info(f"Lap completed! Total laps: {self.lap_count}")
            self.reset_pair()
        elif dt > self.lock_timeout or (A.x + B.x) / 2 < -4.0:
            self.get_logger().info("No crossing from dead-reckoned gate pair, discarding")
            self.reset_pair()

    def reset_pair(self):
        # re-arming requires a far-away sighting again (natural cooldown)
        self.locked = False
        self.pair = None
        self.pair_time = None
        self.pair_sign = 0.0

    def odom_callback(self, msg):
        self.car_vel = [msg.twist.twist.linear.x, msg.twist.twist.linear.y]

    def publish_lap_count(self):
        msg = UInt16()
        msg.data = self.lap_count
        self.lap_counter_pub.publish(msg)


def main(args=None):
    rclpy.init(args=args)
    lap_counter = LapCounter()

    try:
        rclpy.spin(lap_counter)
    except KeyboardInterrupt:
        pass
    finally:
        lap_counter.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()