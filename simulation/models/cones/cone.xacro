<?xml version="1.0"?>
<sdf version='1.7' xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Macro to define a cone -->
    <xacro:macro name="cone" params="name type pose">
    <model name="${name}">
        <static>true</static>
        <pose>${pose}</pose>
        <link name="${name}_link">
            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://simulation/models/cones/cone_${type}/mesh.dae</uri>
                    </mesh>
                </geometry>
            </visual>

            <!-- Different inertial properties for different types of cones -->
            <inertial>
                <xacro:if value="${type == 'large_orange'}">
                    <mass>1.05</mass>
                    <!-- Edit centre of mass later -->
                    <inertia>
                        <ixx>0.003</ixx>
                        <ixy>0.0</ixy>
                        <ixz>0.0</ixz>
                        <iyy>0.003</iyy>
                        <iyz>0.0</iyz>
                        <izz>0.002</izz>
                    </inertia>
                </xacro:if>
                <xacro:unless value="${type == 'large_orange'}">
                    <mass>0.45</mass>
                    <inertia>
                        <ixx>0.013</ixx>
                        <ixy>0.0</ixy>
                        <ixz>0.0</ixz>
                        <iyy>0.013</iyy>
                        <iyz>0.0</iyz>
                        <izz>0.006</izz>
                    </inertia>
                </xacro:unless>
            </inertial>
        </link>
    </model>
    </xacro:macro>

</sdf>